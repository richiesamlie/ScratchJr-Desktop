{
    "name": "ScratchJr",
    "productName": "ScratchJr",
    "version": "1.5.3",
    "description": "ScratchJr Desktop Edition",
    "main": "src/main.js",
    "scripts": {
        "start": "electron-forge start",
        "debugMain": "electron-forge start -i",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "make64": "electron-forge make --arch=x64",
        "make32": "electron-forge make --arch=ia32",
        "makeAll": "electron-forge make --arch=ia32,x64",
        "make:zip": "node scripts/package-and-zip.js",
        "lint": "eslint src --color",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "build:renderer": "node scripts/build-renderer.js",
        "postinstall": "node scripts/patch-for-node26.js && node scripts/build-renderer.js"
    },
    "keywords": [],
    "author": "ScratchJr - Open Source Community Port",
    "license": "BSD-3-Clause",
    "app-copyright": "Copyright (c) 2016, Massachusetts Institute of Technology",
    "config": {
        "forge": "./forge.config.js"
    },
    "eslintConfig": {
        "extends": "eslint-config-airbnb-base",
        "parserOptions": {
            "ecmaVersion": 2022,
            "sourceType": "module",
            "ecmaFeatures": {}
        },
        "rules": {
            "no-use-before-define": 0,
            "max-len": 0,
            "no-multi-spaces": 0,
            "no-param-reassign": 0,
            "indent": 0,
            "padded-blocks": 0,
            "class-methods-use-this": 0,
            "trailing-spaces-not-allowed": 0,
            "vars-on-top": 0,
            "no-trailing-spaces": 0,
            "no-multiple-empty-lines": 0,
            "no-continue": 0,
            "no-plusplus": 0,
            "spaced-comment": 0,
            "no-var": 0,
            "eqeqeq": 0,
            "prefer-template": 0,
            "camelcase": 0,
            "space-before-blocks": 0,
            "quote-props": 0,
            "quotes": [
                "error",
                "single",
                {
                    "allowTemplateLiterals": true
                }
            ],
            "comma-dangle": 0,
            "default-case": 0,
            "no-useless-escape": 0,
            "yoda": 0,
            "no-useless-return": 0,
            "space-before-function-paren": 0,
            "one-var-declaration-per-line": 0,
            "object-curly-spacing": 0,
            "prefer-const": 0,
            "func-call-spacing": 0,
            "no-tabs": 0,
            "func-names": 0,
            "prefer-arrow-callback": 0,
            "no-mixed-spaces-and-tabs": 0,
            "no-mixed-operators": 0,
            "no-return-await": 0,
            "no-unused-vars": [
                2,
                {
                    "args": "after-used",
                    "varsIgnorePattern": "^_",
                    "argsIgnorePattern": "^_"
                }
            ],
            "import/no-extraneous-dependencies": [
                "error",
                {
                    "devDependencies": [
                        "scripts/**",
                        "tests/**",
                        "vitest.config.*",
                        "src/main/**",
                        "src/main.js",
                        "src/preload.js",
                        "src/lib/**",
                        "src/app/**"
                    ]
                }
            ],
            "import/no-unresolved": [
                2,
                {
                    "ignore": [
                        "vitest"
                    ]
                }
            ],
            "import/no-cycle": 0,
            "import/prefer-default-export": 0,
            "default-case-last": 0,
            "no-constructor-return": 0,
            "no-new-func": 0,
            "function-call-argument-newline": 0,
            "no-restricted-properties": [
                0,
                {
                    "object": "Math",
                    "property": "pow",
                    "message": "Use the exponentiation operator (**) instead."
                }
            ],
            "no-restricted-syntax": 0,
            "no-nested-ternary": 0,
            "import/extensions": 0,
            "no-useless-concat": 0,
            "no-unneeded-ternary": [
                "error",
                {
                    "defaultAssignment": true
                }
            ],
            "one-var": 0,
            "object-shorthand": 0,
            "operator-assignment": 0,
            "no-lonely-if": 0,
            "no-else-return": 0,
            "no-shadow": 0,
            "no-undef-init": 0,
            "radix": 0,
            "no-bitwise": 0,
            "guard-for-in": 0,
            "lines-between-class-members": 0,
            "prefer-destructuring": 0,
            "no-underscore-dangle": 0,
            "consistent-return": 0,
            "global-require": 0,
            "object-curly-newline": 0,
            "comma-spacing": 0,
            "function-paren-newline": 0,
            "max-classes-per-file": 0,
            "semi": 0,
            "no-restricted-globals": 0
        },
        "settings": {
            "import/resolver": {
                "node": {
                    "extensions": [
                        ".js",
                        ".ts",
                        ".d.ts"
                    ]
                }
            }
        },
        "globals": {
            "AndroidInterface": true,
            "window": true,
            "WebKitCSSMatrix": true,
            "electron": true,
            "require": true,
            "globalThis": true,
            "isTouch": true
        },
        "env": {
            "browser": true,
            "node": true
        }
    },
    "eslintIgnore": [
        "./src/app/src/snap/snap.svg-min.js",
        "./src/app/dist/*",
        "src/app/dist/**"
    ],
    "dependencies": {
        "eve": "~0.5.4",
        "sql.js": "^1.8.0"
    },
    "devDependencies": {
        "@electron-forge/cli": "^7.8.3",
        "@electron-forge/maker-deb": "^7.8.3",
        "@electron-forge/maker-rpm": "^7.8.3",
        "@electron-forge/maker-squirrel": "^7.11.2",
        "@electron-forge/maker-wix": "^7.8.3",
        "@electron-forge/maker-zip": "^7.8.3",
        "@electron/packager": "^20.2.0",
        "@reforged/maker-appimage": "^5.0.0",
        "@types/node": "^26.2.0",
        "electron": "^42.4.0",
        "esbuild": "^0.28.2",
        "eslint": "^8.31.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-plugin-import": "^2.26.0",
        "intl-messageformat": "^11.2.13",
        "jsdom": "^30.0.1",
        "jszip": "^3.10.1",
        "snapsvg": "^0.5.1",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "tar": "^7.5.21",
        "tmp": "^0.2.6"
    }
}
